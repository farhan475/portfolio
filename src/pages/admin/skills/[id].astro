---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import FlashMessage from '../../../components/admin/FlashMessage.astro';
import Field from '../../../components/admin/Field.astro';
import { skillFormSchema } from '../../../lib/schemas';
import { backTo, formBool, formInt, formRequired, formText, zodMessage } from '../../../lib/form';
import { buttonGhost, buttonPrimary, checkboxClass, inputClass } from '../../../lib/ui';

const supabase = Astro.locals.supabase!;
const { id } = Astro.params;

if (!id) return Astro.rewrite('/404');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const parsed = skillFormSchema.safeParse({
    name: formRequired(form, 'name'),
    category: formText(form, 'category') ?? 'Lainnya',
    icon: formText(form, 'icon'),
    sort_order: formInt(form, 'sort_order', 0),
    is_visible: formBool(form, 'is_visible'),
  });

  if (!parsed.success) {
    return Astro.redirect(backTo(`/admin/skills/${id}`, { error: zodMessage(parsed.error) }), 303);
  }

  const { error } = await supabase.from('skills').update(parsed.data).eq('id', id);
  return Astro.redirect(
    backTo(error ? `/admin/skills/${id}` : '/admin/skills', error ? { error: error.message } : { ok: 'Keahlian diperbarui.' }),
    303,
  );
}

const { data: skill } = await supabase.from('skills').select('*').eq('id', id).maybeSingle();
if (!skill) return Astro.rewrite('/404');
---

<AdminLayout title={`Edit: ${skill.name}`} description="Ubah detail keahlian.">
  <FlashMessage />

  <form method="post" class="flex flex-col gap-4">
    <Field id="name" label="Nama" required>
      <input id="name" name="name" type="text" value={skill.name} required class={inputClass} />
    </Field>

    <Field id="category" label="Kategori" hint="Misal Backend, Database, Tools.">
      <input id="category" name="category" type="text" value={skill.category} class={inputClass} />
    </Field>

    <Field id="icon" label="Ikon" hint="Nama ikon Lucide atau URL gambar.">
      <input id="icon" name="icon" type="text" value={skill.icon ?? ''} class={inputClass} />
    </Field>

    <Field id="sort_order" label="Urutan">
      <input id="sort_order" name="sort_order" type="number" value={skill.sort_order} class={inputClass} />
    </Field>

    <label class="flex items-center gap-2 text-sm">
      <input type="checkbox" name="is_visible" checked={skill.is_visible} class={checkboxClass} />
      Tampilkan di situs
    </label>

    <div class="flex gap-3">
      <button type="submit" class={buttonPrimary}>Simpan</button>
      <a href="/admin/skills" class={buttonGhost}>Batal</a>
    </div>
  </form>
</AdminLayout>
