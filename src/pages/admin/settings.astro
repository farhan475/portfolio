---
import { RotateCcw, Undo2 } from 'lucide-react';
import AdminLayout from '../../layouts/AdminLayout.astro';
import FlashMessage from '../../components/admin/FlashMessage.astro';
import Field from '../../components/admin/Field.astro';
import ImageUploader from '../../components/admin/ImageUploader.tsx';
import PairListEditor from '../../components/admin/PairListEditor.tsx';
import { getSiteSettings } from '../../lib/queries';
import { DEFAULT_THEME, navItemsSchema, siteSettingsFormSchema, themeSchema } from '../../lib/schemas';
import { backTo, formRequired, formText, zodMessage } from '../../lib/form';
import { removeOrphanAssets } from '../../lib/storage';
import { buttonDanger, buttonGhost, buttonInline, buttonPrimary, inputClass } from '../../lib/ui';

const supabase = Astro.locals.supabase!;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  let navItemsRaw: unknown = [];
  try {
    navItemsRaw = JSON.parse(String(form.get('nav_items') ?? '[]'));
  } catch {
    navItemsRaw = [];
  }

  const parsed = siteSettingsFormSchema.safeParse({
    site_title: formRequired(form, 'site_title'),
    meta_description: formText(form, 'meta_description'),
    og_image_url: formText(form, 'og_image_url'),
    favicon_url: formText(form, 'favicon_url'),
    logo_text: formText(form, 'logo_text'),
    logo_url: formText(form, 'logo_url'),
    footer_text: formText(form, 'footer_text'),
    resume_url: formText(form, 'resume_url'),
    nav_items: navItemsRaw,
    theme: {
      primary: formRequired(form, 'theme_primary'),
      accent: formRequired(form, 'theme_accent'),
      background: formRequired(form, 'theme_background'),
      foreground: formRequired(form, 'theme_foreground'),
      font_heading: formRequired(form, 'theme_font_heading'),
      font_body: formRequired(form, 'theme_font_body'),
      default_mode: formRequired(form, 'theme_default_mode'),
    },
  });

  if (!parsed.success) {
    return Astro.redirect(backTo('/admin/settings', { error: zodMessage(parsed.error) }), 303);
  }

  const { data: before } = await supabase
    .from('site_settings')
    .select('og_image_url, favicon_url, logo_url, resume_url')
    .eq('id', 1)
    .maybeSingle();

  const { error } = await supabase
    .from('site_settings')
    .update({ ...parsed.data, theme: parsed.data.theme, nav_items: parsed.data.nav_items })
    .eq('id', 1);

  if (!error && before) {
    await removeOrphanAssets(
      supabase,
      [before.og_image_url, before.favicon_url, before.logo_url, before.resume_url],
      [parsed.data.og_image_url, parsed.data.favicon_url, parsed.data.logo_url, parsed.data.resume_url],
    );
  }

  return Astro.redirect(
    backTo('/admin/settings', error ? { error: error.message } : { ok: 'Pengaturan situs tersimpan.' }),
    303,
  );
}

const settings = await getSiteSettings(supabase);
const theme = settings?.theme ?? themeSchema.parse({});
const navItems = navItemsSchema.parse(settings?.nav_items ?? []);

/** `fallback` dipakai tombol reset, sumbernya skema yang sama dengan default database. */
const COLORS = [
  { name: 'theme_primary', label: 'Primary', value: theme.primary, fallback: DEFAULT_THEME.primary },
  { name: 'theme_accent', label: 'Accent', value: theme.accent, fallback: DEFAULT_THEME.accent },
  {
    name: 'theme_background',
    label: 'Background (mode gelap)',
    value: theme.background,
    fallback: DEFAULT_THEME.background,
  },
  {
    name: 'theme_foreground',
    label: 'Foreground (mode gelap)',
    value: theme.foreground,
    fallback: DEFAULT_THEME.foreground,
  },
];
---

<AdminLayout title="Pengaturan Situs" description="SEO, logo, tema, dan menu navigasi.">
  <FlashMessage />

  <form method="post" class="flex flex-col gap-8" data-settings-form>
    <section class="flex flex-col gap-4" aria-labelledby="bagian-identitas">
      <h2 id="bagian-identitas" class="text-lg font-semibold">Identitas dan SEO</h2>

      <Field id="site_title" label="Judul situs" required hint="Dipakai di tag title dan OpenGraph.">
        <input
          id="site_title"
          name="site_title"
          type="text"
          required
          value={settings?.site_title ?? ''}
          class={inputClass}
        />
      </Field>

      <Field id="meta_description" label="Meta description" hint="Idealnya 120-160 karakter.">
        <textarea id="meta_description" name="meta_description" rows="3" data-default="" class={inputClass}
          >{settings?.meta_description ?? ''}</textarea
        >
      </Field>

      <Field id="logo_text" label="Teks logo">
        <input
          id="logo_text"
          name="logo_text"
          type="text"
          value={settings?.logo_text ?? ''}
          data-default=""
          class={inputClass}
        />
      </Field>

      <Field id="footer_text" label="Teks footer">
        <input
          id="footer_text"
          name="footer_text"
          type="text"
          value={settings?.footer_text ?? ''}
          data-default=""
          class={inputClass}
        />
      </Field>

      <ImageUploader client:load name="og_image_url" label="Gambar OpenGraph" value={settings?.og_image_url} folder="site" hint="Rasio 1200x630 memberi hasil terbaik. Maksimal 2 MB." />
      <ImageUploader client:load name="favicon_url" label="Favicon" value={settings?.favicon_url} folder="site" />
      <ImageUploader client:load name="logo_url" label="Gambar logo" value={settings?.logo_url} folder="site" hint="Opsional. Kalau kosong, teks logo yang dipakai." />
      <ImageUploader client:load name="resume_url" label="Resume (PDF)" value={settings?.resume_url} folder="site" hint="Unggah PDF, maksimal 2 MB." />
    </section>

    <section class="flex flex-col gap-4" aria-labelledby="bagian-tema">
      <h2 id="bagian-tema" class="text-lg font-semibold">Tema</h2>
      <p class="-mt-2 text-sm text-muted">
        Mode terang menukar background dan foreground secara otomatis, jadi cukup atur pasangan warna mode gelap.
      </p>

      <div class="grid gap-4 sm:grid-cols-2">
        {
          COLORS.map((color) => (
            <Field id={color.name} label={color.label}>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                <input
                  id={color.name}
                  name={color.name}
                  type="color"
                  value={color.value}
                  data-color-input
                  data-theme-field
                  data-default={color.fallback}
                  class="size-10 shrink-0 cursor-pointer rounded-md border border-border-strong bg-surface p-1"
                />
                <output class="font-mono text-sm text-muted" data-color-output={color.name}>
                  {color.value}
                </output>
                <button type="button" class={buttonInline} data-color-revert={color.name} disabled>
                  <Undo2 size={14} aria-hidden="true" />
                  Kembalikan
                </button>
              </div>
            </Field>
          ))
        }
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <Field id="theme_font_heading" label="Font judul" hint="Nama font Google Fonts, misal Inter.">
          <input
            id="theme_font_heading"
            name="theme_font_heading"
            type="text"
            value={theme.font_heading}
            data-theme-field
            data-default={DEFAULT_THEME.font_heading}
            class={inputClass}
          />
        </Field>

        <Field id="theme_font_body" label="Font isi" hint="Nama font Google Fonts, misal Inter.">
          <input
            id="theme_font_body"
            name="theme_font_body"
            type="text"
            value={theme.font_body}
            data-theme-field
            data-default={DEFAULT_THEME.font_body}
            class={inputClass}
          />
        </Field>
      </div>

      <Field
        id="theme_default_mode"
        label="Mode bawaan"
        hint="Dipakai saat pengunjung belum pernah menekan tombol mode. 'Ikut perangkat' memakai setelan gelap/terang di HP atau laptop pengunjung. Tombol mode di situs tetap ada pada pilihan apa pun."
      >
        <select
          id="theme_default_mode"
          name="theme_default_mode"
          data-theme-field
          data-default={DEFAULT_THEME.default_mode}
          class={inputClass}
        >
          <option value="system" selected={theme.default_mode === 'system'}>Ikut perangkat</option>
          <option value="dark" selected={theme.default_mode === 'dark'}>Gelap</option>
          <option value="light" selected={theme.default_mode === 'light'}>Terang</option>
        </select>
      </Field>

      <div>
        <button type="button" class:list={[buttonGhost, 'inline-flex items-center gap-1.5']} data-reset-theme>
          <RotateCcw size={16} aria-hidden="true" />
          Reset tema ke bawaan
        </button>
        <p class="mt-1.5 text-xs text-muted">
          Mengembalikan warna, font, dan mode bawaan ke setelan awal. Belum tersimpan sampai kamu menekan Simpan.
        </p>
      </div>
    </section>

    <section class="flex flex-col gap-4" aria-labelledby="bagian-nav">
      <h2 id="bagian-nav" class="text-lg font-semibold">Menu navigasi</h2>
      <PairListEditor
        client:load
        name="nav_items"
        label="Daftar menu"
        fields={[
          { key: 'label', label: 'Label' },
          { key: 'href', label: 'Href' },
        ]}
        value={navItems}
        addLabel="Tambah menu"
        emptyText="Belum ada menu. Tambahkan minimal satu."
      />
    </section>

    <div class="flex flex-col gap-3 border-t border-border pt-6 sm:flex-row sm:flex-wrap sm:items-center">
      <button type="submit" class={buttonPrimary}>Simpan pengaturan</button>
      <button type="button" class:list={[buttonGhost, 'inline-flex items-center justify-center gap-1.5']} data-revert-all>
        <Undo2 size={16} aria-hidden="true" />
        Batalkan perubahan
      </button>
      <button type="button" class:list={[buttonDanger, 'inline-flex items-center justify-center gap-1.5']} data-reset-all>
        <RotateCcw size={16} aria-hidden="true" />
        Reset semua ke bawaan
      </button>
    </div>

    <p class="-mt-4 text-xs text-muted">
      Reset hanya mengubah isi form. Judul situs tidak ikut direset karena wajib diisi, dan tidak ada yang berubah di
      situs sampai kamu menekan Simpan.
    </p>
  </form>
</AdminLayout>

<script>
  import { emitAdminReset } from '../../lib/reset';

  type Control = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;

  const form = document.querySelector<HTMLFormElement>('[data-settings-form]');

  function colorInputs(): HTMLInputElement[] {
    return Array.from(document.querySelectorAll<HTMLInputElement>('[data-color-input]'));
  }

  /** Tampilkan nilai hex di samping tiap color picker. */
  function syncColorOutputs() {
    for (const input of colorInputs()) {
      const output = document.querySelector<HTMLElement>(`[data-color-output="${input.name}"]`);
      if (output) output.textContent = input.value;
    }
  }

  /** Tombol kembalikan hanya berguna kalau warnanya memang sudah diubah. */
  function syncRevertButtons() {
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-color-revert]')) {
      const input = colorInputs().find((item) => item.name === button.dataset.colorRevert);
      // Browser menormalkan value color jadi huruf kecil, atribut asli belum tentu.
      button.disabled = !input || input.value.toLowerCase() === input.defaultValue.toLowerCase();
    }
  }

  function sync() {
    syncColorOutputs();
    syncRevertButtons();
  }

  function applyDefaults(selector: string) {
    for (const control of document.querySelectorAll<Control>(selector)) {
      control.value = control.dataset.default ?? '';
    }
  }

  form?.addEventListener('input', sync);
  form?.addEventListener('change', sync);

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-color-revert]')) {
    button.addEventListener('click', () => {
      const input = colorInputs().find((item) => item.name === button.dataset.colorRevert);
      if (input) input.value = input.defaultValue;
      sync();
    });
  }

  document.querySelector('[data-reset-theme]')?.addEventListener('click', () => {
    applyDefaults('[data-theme-field]');
    sync();
  });

  document.querySelector('[data-revert-all]')?.addEventListener('click', () => {
    // reset() mengembalikan kontrol native ke nilai tersimpan; island React
    // memegang state sendiri, jadi diberi tahu lewat event.
    form?.reset();
    emitAdminReset('stored');
    sync();
  });

  document.querySelector('[data-reset-all]')?.addEventListener('click', () => {
    const confirmed = window.confirm(
      'Kembalikan semua pengaturan ke nilai bawaan? Gambar, menu navigasi, dan teks akan dikosongkan. Judul situs dipertahankan, dan perubahan baru berlaku setelah disimpan.',
    );
    if (!confirmed) return;

    applyDefaults('[data-default]');
    emitAdminReset('default');
    sync();
  });

  sync();
</script>
