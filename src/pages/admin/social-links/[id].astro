---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import FlashMessage from '../../../components/admin/FlashMessage.astro';
import Field from '../../../components/admin/Field.astro';
import { socialLinkFormSchema } from '../../../lib/schemas';
import { backTo, formBool, formInt, formRequired, formText, zodMessage } from '../../../lib/form';
import { buttonGhost, buttonPrimary, checkboxClass, inputClass } from '../../../lib/ui';

const supabase = Astro.locals.supabase!;
const { id } = Astro.params;

if (!id) return Astro.rewrite('/404');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const parsed = socialLinkFormSchema.safeParse({
    platform: formRequired(form, 'platform'),
    url: formRequired(form, 'url'),
    icon: formText(form, 'icon'),
    sort_order: formInt(form, 'sort_order', 0),
    is_visible: formBool(form, 'is_visible'),
  });

  if (!parsed.success) {
    return Astro.redirect(backTo(`/admin/social-links/${id}`, { error: zodMessage(parsed.error) }), 303);
  }

  const { error } = await supabase.from('social_links').update(parsed.data).eq('id', id);
  return Astro.redirect(
    backTo(
      error ? `/admin/social-links/${id}` : '/admin/social-links',
      error ? { error: error.message } : { ok: 'Tautan sosial diperbarui.' },
    ),
    303,
  );
}

const { data: socialLink } = await supabase.from('social_links').select('*').eq('id', id).maybeSingle();
if (!socialLink) return Astro.rewrite('/404');
---

<AdminLayout title={`Edit: ${socialLink.platform}`} description="Ubah detail tautan sosial.">
  <FlashMessage />

  <form method="post" class="flex flex-col gap-4">
    <Field id="platform" label="Platform" required>
      <input id="platform" name="platform" type="text" value={socialLink.platform} required class={inputClass} />
    </Field>

    <Field id="url" label="URL" required hint="Boleh juga mailto:email@contoh.com">
      <input id="url" name="url" type="text" value={socialLink.url} required class={inputClass} />
    </Field>

    <Field
      id="icon"
      label="Ikon"
      hint="Nama ikon Lucide, atau github/linkedin/x/instagram/youtube/facebook/telegram"
    >
      <input id="icon" name="icon" type="text" value={socialLink.icon ?? ''} class={inputClass} />
    </Field>

    <Field id="sort_order" label="Urutan">
      <input id="sort_order" name="sort_order" type="number" value={socialLink.sort_order} class={inputClass} />
    </Field>

    <label class="flex items-center gap-2 text-sm">
      <input type="checkbox" name="is_visible" checked={socialLink.is_visible} class={checkboxClass} />
      Tampilkan di situs
    </label>

    <div class="flex gap-3">
      <button type="submit" class={buttonPrimary}>Simpan</button>
      <a href="/admin/social-links" class={buttonGhost}>Batal</a>
    </div>
  </form>
</AdminLayout>
