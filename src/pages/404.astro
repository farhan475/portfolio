---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getSiteSettings, getSocialLinks, type SiteSettings, type SocialLink } from '../lib/queries';

Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'no-store');

let settings: SiteSettings | null = null;
let socialLinks: SocialLink[] = [];

const supabase = Astro.locals.supabase;

if (supabase) {
  [settings, socialLinks] = await Promise.all([getSiteSettings(supabase), getSocialLinks(supabase)]);
}
---

<BaseLayout settings={settings} title="Halaman tidak ditemukan" noindex>
  <Navbar settings={settings} />
  <main id="konten" class="container-page flex min-h-[60vh] flex-col items-center justify-center py-16 text-center sm:py-20">
    <p class="font-heading text-5xl font-semibold text-primary sm:text-6xl">404</p>
    <h1 class="mt-4 text-xl font-semibold sm:text-2xl">Halaman tidak ditemukan</h1>
    <p class="mt-3 max-w-md text-muted">
      Alamat yang kamu buka tidak ada atau sudah dipindahkan.
    </p>
    <a
      href="/"
      class="mt-8 rounded-md bg-primary px-5 py-2.5 text-sm font-medium text-background transition-opacity hover:opacity-90"
    >
      Kembali ke beranda
    </a>
  </main>
  <Footer settings={settings} socialLinks={socialLinks} />
</BaseLayout>
