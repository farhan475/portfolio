---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SectionRenderer from '../components/SectionRenderer.astro';
import {
  getExperiences,
  getProjects,
  getSiteSettings,
  getSkills,
  getSocialLinks,
  getVisibleSections,
  type Experience,
  type Project,
  type Section,
  type SiteSettings,
  type SocialLink,
  type Skill,
} from '../lib/queries';

// Nilai ini ditetapkan CLAUDE.md. Sempat diperlebar ke s-maxage=300 +
// stale-while-revalidate=86400 lalu dikembalikan atas permintaan. Catatan
// pengukuran supaya angkanya tidak perlu dicari ulang: TTFB 75-90ms saat
// cache kena, 1.2s saat MISS, dan pernah 6.5s saat cold start, karena tiap
// halaman di-SSR dengan enam query Supabase. Jendela ini hanya menutup enam
// menit, jadi MISS relatif sering dan itulah yang terukur kalau situs diaudit
// pada saat cache sedang kosong.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

let settings: SiteSettings | null = null;
let sections: Section[] = [];
let projects: Project[] = [];
let skills: Skill[] = [];
let experiences: Experience[] = [];
let socialLinks: SocialLink[] = [];

const supabase = Astro.locals.supabase;

if (supabase) {
  [settings, sections, projects, skills, experiences, socialLinks] = await Promise.all([
    getSiteSettings(supabase),
    getVisibleSections(supabase),
    getProjects(supabase),
    getSkills(supabase),
    getExperiences(supabase),
    getSocialLinks(supabase),
  ]);
}

// Hero adalah satu-satunya section yang gambarnya berada di atas lipatan, jadi
// hanya itu yang layak diprioritaskan. Diambil dari data, bukan dihardcode.
const heroSection = sections.find((section) => section.type === 'hero');
const heroImage = heroSection?.type === 'hero' ? heroSection.content.image_url : null;
---

<BaseLayout settings={settings} preloadImage={heroImage}>
  <Navbar settings={settings} />
  <main id="konten">
    {
      sections.length === 0 ? (
        <section class="container-page py-24">
          <h1 class="text-3xl font-semibold">Belum ada section</h1>
          <p class="mt-3 text-muted">
            Tambahkan section lewat halaman admin, atau jalankan
            <code class="rounded border border-border px-1">supabase/schema-portfolio.sql</code>
            bila database masih kosong.
          </p>
        </section>
      ) : (
        <SectionRenderer
          sections={sections}
          skills={skills}
          projects={projects}
          experiences={experiences}
        />
      )
    }
  </main>
  <Footer settings={settings} socialLinks={socialLinks} />
</BaseLayout>
