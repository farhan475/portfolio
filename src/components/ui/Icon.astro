---
import { icons } from 'lucide-react';
import BrandIcon from './BrandIcon.astro';

/**
 * Menerima nama ikon apa adanya dari database (`skills.icon`, `social_links.icon`).
 * Urutan pencarian: ikon brand -> ikon Lucide -> tidak merender apa pun.
 * Komponen Lucide dirender di server, tidak ada JavaScript yang dikirim ke browser.
 */
interface Props {
  name?: string | null;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

const BRAND_ALIASES: Record<string, string> = {
  twitter: 'x',
  'x-twitter': 'x',
  ig: 'instagram',
  fb: 'facebook',
  yt: 'youtube',
};

const raw = (name ?? '').trim();
const key = raw.toLowerCase();
const brandKey = BRAND_ALIASES[key] ?? key;
const isBrand = ['github', 'linkedin', 'x', 'instagram', 'youtube', 'facebook', 'telegram'].includes(
  brandKey,
);

/** "arrow-right" atau "arrowRight" -> "ArrowRight" */
function toPascalCase(value: string): string {
  return value
    .replace(/([a-z0-9])([A-Z])/g, '$1-$2')
    .split(/[-_\s]+/)
    .filter(Boolean)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1).toLowerCase())
    .join('');
}

const LucideIcon = isBrand ? undefined : icons[toPascalCase(raw) as keyof typeof icons];
---

{
  isBrand ? (
    <BrandIcon name={brandKey} size={size} class={className} />
  ) : LucideIcon ? (
    <LucideIcon size={size} className={className} aria-hidden="true" focusable="false" />
  ) : null
}
