---
import SectionShell from './SectionShell.astro';
import type { ExperienceContent } from '../../lib/schemas';
import type { Experience } from '../../lib/queries';
import { formatMonthYear } from '../../lib/utils';

interface Props {
  id: string;
  title?: string | null;
  subtitle?: string | null;
  content: ExperienceContent;
  experiences: Experience[];
}

const { id, title, subtitle, content, experiences } = Astro.props;
---

<SectionShell id={id} title={title} subtitle={subtitle}>
  {
    experiences.length === 0 ? (
      <p class="text-sm text-muted">Belum ada pengalaman yang ditambahkan.</p>
    ) : content.timeline ? (
      <ol class="space-y-8 border-l border-border pl-5 sm:space-y-10 sm:pl-6">
        {experiences.map((exp) => (
          <li class="relative">
            <span class="absolute top-1.5 -left-[1.4rem] size-2.5 rounded-full bg-primary sm:-left-[1.6rem]" />
            <h3 class="font-semibold">{exp.role}</h3>
            <p class="text-sm text-muted">
              {exp.company_url ? (
                <a href={exp.company_url} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                  {exp.company}
                </a>
              ) : (
                exp.company
              )}
              {exp.location && <> · {exp.location}</>}
            </p>
            <p class="mt-1 text-sm text-muted">
              {formatMonthYear(exp.start_date)} — {formatMonthYear(exp.end_date)}
            </p>
            {exp.description && <p class="mt-3 whitespace-pre-line text-foreground/90">{exp.description}</p>}
          </li>
        ))}
      </ol>
    ) : (
      <ol class="grid gap-4 sm:grid-cols-2">
        {experiences.map((exp) => (
          <li class="min-w-0 rounded-lg border border-border bg-surface p-4 sm:p-5">
            <h3 class="font-semibold">{exp.role}</h3>
            <p class="text-sm text-muted">
              {exp.company_url ? (
                <a href={exp.company_url} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                  {exp.company}
                </a>
              ) : (
                exp.company
              )}
              {exp.location && <> · {exp.location}</>}
            </p>
            <p class="mt-1 text-sm text-muted">
              {formatMonthYear(exp.start_date)} — {formatMonthYear(exp.end_date)}
            </p>
            {exp.description && <p class="mt-3 whitespace-pre-line text-foreground/90">{exp.description}</p>}
          </li>
        ))}
      </ol>
    )
  }
</SectionShell>
