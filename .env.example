# Salin ke .env lalu isi dari Supabase Dashboard > Project Settings > API Keys.
# Gunakan publishable key (sb_publishable_...) atau legacy anon key.
# JANGAN pernah menaruh secret key atau service_role di sini.
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Opsional. Dipakai untuk canonical URL, OpenGraph, dan sitemap.
# Di Vercel boleh dikosongkan; domain produksi terdeteksi otomatis.
PUBLIC_SITE_URL=https://domainmu.com
